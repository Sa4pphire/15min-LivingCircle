# Windows localhost demo. Copy this file to the repository-root .env.
# Fill in the server key on the reviewer's computer.
# Put the browser key in frontend/.env.local as VITE_BAIDU_BROWSER_AK.
BAIDU_SERVER_AK=

APP_ENV=development
REGION_ID=shanghai-new-jiangwan
REGION_STORAGE_BACKEND=file

# Optional editor publication to MySQL; keep file mode for local authoring.
# Install backend/requirements-mysql.txt and initialize the tables first.
# These values stay on the backend; never put them in frontend/.env.local.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=livingcircle
MYSQL_USER=livingcircle
MYSQL_PASSWORD=
# A Docker-internal hostname such as mysql is not reachable from Windows.
# Optional loopback port mapping: deploy/mysql.local.compose.yml.

# The launcher resolves engine and region paths automatically.
# Other local paths use the application defaults.
