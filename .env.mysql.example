# Copy to .env.mysql and fill credentials. Do not commit the resulting file.
# Used with --env-file .env.mysql AND BACKEND_ENV_FILE below.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=livingcircle
MYSQL_USER=livingcircle
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REGION_STORAGE_BACKEND=mysql
REGION_ID=shanghai-new-jiangwan
WITH_MYSQL=true
BACKEND_IMAGE=vct-backend:mysql
BACKEND_ENV_FILE=../.env.mysql
DEPLOY_NETWORK=vct
DATA_DIR=../data
# Copy your needed BAIDU_SERVER_AK/AGENT_* settings here, server side only.
# BAIDU_SERVER_AK=
# AGENT_ENABLED=false
