# Split frontend/backend Docker demo: copy to the repository-root .env.
# Browser-visible key, passed only to the frontend build. Restrict its Referer.
# Rebuild only frontend after changing this key.
VITE_BAIDU_BROWSER_AK=
LOCAL_PORT=8000
# Runtime origin from the frontend container; no path or trailing slash.
# Changing this needs only a frontend container recreate, not a Vue rebuild.
API_UPSTREAM=http://backend:8000
FRONTEND_IMAGE=vct-frontend:local
BACKEND_IMAGE=vct-backend:local
# File mode stays the default. MySQL setup: docs/mysql-region-storage.md.
REGION_STORAGE_BACKEND=file
WITH_MYSQL=false


# Server-only key. Never expose it to the browser or commit a real value.
BAIDU_SERVER_AK=
BAIDU_API_BASE_URL=https://api.map.baidu.com
BAIDU_TIMEOUT_SECONDS=10
BAIDU_MAX_CONCURRENCY=2
# Shared pacing across callers using the same cache DB; tune to account quota.
BAIDU_MAX_QPS=1
BAIDU_MAX_RETRIES=2
CACHE_TTL_HOURS=24
# Shared with all BaiduClient callers; relative paths resolve against the repo.
# For local use: ANALYSIS_CACHE_DIR=data/cache
POI_CACHE_TTL_HOURS=168
POI_CACHE_STALE_HOURS=720
POI_EMPTY_CACHE_TTL_HOURS=24
POI_MAX_PAGES=8
POI_BUDGET_SECONDS=12
# Stable circle tiles; independent keywords; a hard HTTP budget per search.
POI_TILE_METERS=1000
POI_MAX_TILES=64
POI_MAX_REQUESTS=96
# Optional prepared frontend/backend coordinate mesh (same origin required).
# POI_MAP_ASSET_PATH=data/regions/shanghai-new-jiangwan/alignment.bd09.json
POI_SNAP_METERS=3
# Optional lease/cooldown DB and read-only legacy cache migration source.
# POI_CACHE_PATH=data/cache/baidu-pois.sqlite3

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
ANALYSIS_CACHE_DIR=/app/data/cache
CPP_ENGINE_PATH=/app/bin/isochrone_engine
WALKING_NETWORK_PATH=/app/data/networks/shanghai-new-jiangwan.json
# Both C++ demo modes read this existing modeled synthetic graph.
REGION_ID=shanghai-new-jiangwan
# The active region manifest supplies its network and calibration files.
# SYNTHETIC_NETWORK_PATH=/app/data/regions/shanghai-new-jiangwan/network.json
# Optional independent 180-second override; unset uses SYNTHETIC_NETWORK_PATH.
# LOCAL_EXPERIMENT_NETWORK_PATH=/app/data/regions/shanghai-new-jiangwan/network.json
